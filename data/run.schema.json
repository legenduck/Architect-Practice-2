{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Practice 2 run",
  "type": "object",
  "required": [
    "id",
    "scenario",
    "success"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "scenario": {
      "enum": [
        "context_overload",
        "repeated_work",
        "reasoning_reliance",
        "reference"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "success": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cached_input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "llm_calls": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "tool_calls": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "retries": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "elapsed_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "baseline_sha256": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
